# Leave empty for automatic token creation in the persistent data volume.
# An explicit token overrides the generated file. Coolify generates its own UI-visible token.
MCP_AUTH_TOKEN=
AUTO_AUTH_TOKEN=true
PUBLIC_URL=http://localhost:3000
OAUTH_ENABLED=true
PORT=3000
BIND_ADDRESS=127.0.0.1
SYNC_INTERVAL_SECONDS=900
LOG_LEVEL=info
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
ALLOWED_ORIGINS=
# For remote clients add the public hostname to ALLOWED_HOSTS, and use HTTPS.
# Public read-only operation: clear MCP_AUTH_TOKEN and explicitly set ALLOW_PUBLIC_READ=true.
ALLOW_PUBLIC_READ=false
